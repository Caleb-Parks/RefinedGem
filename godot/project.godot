; Refined Gem — minimal Godot 4.5 project for mod asset packing.
; Imports PNGs at res://assets/* into .ctex for RefinedGem.pck.

config_version=5

[application]

config/name="RefinedGem"
config/features=PackedStringArray("4.5")

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false
}
